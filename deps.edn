{:paths ["src" "resources"]
 :deps {org.clojure/clojure    {:mvn/version "1.12.0"}
        ;; numerics and the kernel compiler (0.2.801 lowers bare unchecked-*
        ;; operators in helper bodies, which the day kernels rely on)
        org.replikativ/raster  {:mvn/version "0.2.801"}
        ;; probabilistic programming over forked execution contexts (city.infer);
        ;; 0.1.48 carries the seeded draws and the MCMC replay fix
        org.replikativ/spindel {:mvn/version "0.1.48"}
        ;; the evidence store: world state, provenance, history
        org.replikativ/datahike {:mvn/version "0.8.1865"}
        org.clojure/data.json  {:mvn/version "2.5.1"}
        org.clojure/data.csv   {:mvn/version "1.1.0"}
        hato/hato              {:mvn/version "1.0.0"}
        http-kit/http-kit      {:mvn/version "2.8.0"}}
 :aliases
 {;; REPL-first development: nREPL + cider, notebooks
  :dev {:extra-paths ["dev" "test" "notebooks"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}
                     org.scicloj/kindly {:mvn/version "4-beta23"}
                     org.scicloj/clay {:mvn/version "2.0.13"}}
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                   "--add-modules=jdk.incubator.vector"
                   "-Xss8m"]
        :main-opts ["-m" "nrepl.cmdline" "--port" "7900"
                    "--middleware" "[cider.nrepl/cider-middleware]"]}
  ;; the Stuttgart demo end to end: clojure -M:demo up | export
  :demo {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "--add-modules=jdk.incubator.vector"
                    "-Xss8m" "-Xmx7g"]
         :main-opts ["-m" "city.demo.stuttgart"]}
  ;; shadow-cljs reads this alias for the browser build
  :ui {:extra-deps {thheller/shadow-cljs {:mvn/version "3.1.7"}
                    applied-science/js-interop {:mvn/version "0.4.2"}}}
  ;; develop against sibling checkouts of raster and spindel:
  ;; clojure -M:local:dev
  :local {:override-deps {org.replikativ/raster  {:local/root "../raster"}
                          org.replikativ/spindel {:local/root "../spindel"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                    "--add-modules=jdk.incubator.vector"]
         ;; tests tagged ^:data read data/derived and are excluded here
         :main-opts ["-m" "cognitect.test-runner" "-e" ":data"]}
  :test-data {:extra-paths ["test"]
              :extra-deps {io.github.cognitect-labs/test-runner
                           {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
              :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                         "--add-modules=jdk.incubator.vector"]
              :main-opts ["-m" "cognitect.test-runner" "-i" ":data"]}}}
